# ==============================================================================
# Pocket Sentinel (v11 Pocket Server) — Environment Configuration Template
# Copy this file to '.env' and fill in the values: cp .env.example .env
# IMPORTANT: Never commit your actual '.env' file containing real secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database Settings
# ------------------------------------------------------------------------------
PORT=8080
DB_PATH=/data/data/com.termux/files/home/go-app/data.db
GIN_MODE=release

# ------------------------------------------------------------------------------
# 2. Public Ingress (ngrok Tunnel)
# Get your free authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: Free static domain from ngrok (e.g. https://yourname.ngrok-free.dev)
# NGROK_DOMAIN=https://spindle-said-hemstitch.ngrok-free.dev

# ------------------------------------------------------------------------------
# 3. Telemetry & Hardware Thresholds (Pocket Sentinel)
# ------------------------------------------------------------------------------
SAMPLE_INTERVAL=60s
RETENTION_MAX_AGE=72h
RETENTION_MAX_ROWS=4320
BATTERY_THRESHOLD=20
DISK_THRESHOLD_GB=5.0

# ------------------------------------------------------------------------------
# 4. Telegram Bot & Outage Alerting (Essential for notifications & Bot commands)
# Create a bot via @BotFather and get your Chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_TIMEOUT=10s
# Optional: Custom Telegram Bot API Server endpoint (leave commented if using official API)
# TELEGRAM_API_URL=https://api.telegram.org

# ------------------------------------------------------------------------------
# 5. Security PINs (Access Control for Hub, Gateways & Modules)
# ------------------------------------------------------------------------------
# Relay PIN: Protects /api/relay/send and /tele-bridge (Default: 1804)
RELAY_PIN=1804

# Reminder PIN: Protects Quiet Schedule reminder creation & deletion (Optional)
# REMINDER_PIN=1804

# Watchtower PIN: Protects Personal Watchtower watcher creation & deletion (Optional)
# WATCHTOWER_PIN=1804

# ------------------------------------------------------------------------------
# 6. AI Integrations (OpenRouter & Google Gemini)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Get free key at https://openrouter.ai/keys)
# Used for: Natural Language Schedule parsing, Telegram Bridge proofreader, Watchtower Incident summary
# NOTE: System strictly enforces 'openrouter/free' tier with zero paid fallbacks.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
# Used for: Daily Digest AI summary and Bot runner
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Model name for Gemini (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 7. Optional Alerts & Integrations
# ------------------------------------------------------------------------------
# Discord Incoming Webhook (Optional fallback notifier for hardware/outage alerts)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Antigravity Agent Runner (Optional: Termux CLI paths for running agent tasks via Bot)
# AGY_BIN_PATH=/data/data/com.termux/files/home/.local/bin/agy
# AGY_WORK_DIR=/data/data/com.termux/files/home/go-app
