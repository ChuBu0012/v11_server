# ==============================================================================
# Pocket Sentinel (v11 Pocket Server) — Environment Configuration Template
# Copy this file to '.env' and fill in the values: cp .env.example .env
# IMPORTANT: Never commit your actual '.env' file containing real secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database Settings
# ------------------------------------------------------------------------------
PORT=8080
DB_PATH=/data/data/com.termux/files/home/go-app/data.db
GIN_MODE=release

# ------------------------------------------------------------------------------
# 2. Ingress & Base URL (Tailscale)
# ------------------------------------------------------------------------------
APP_BASE_URL=http://100.92.194.87:8080

# ------------------------------------------------------------------------------
# 3. Telemetry & Hardware Thresholds (Pocket Sentinel)
# ------------------------------------------------------------------------------
SAMPLE_INTERVAL=60s
RETENTION_MAX_AGE=72h
RETENTION_MAX_ROWS=4320
BATTERY_THRESHOLD=20
DISK_THRESHOLD_GB=5.0

# ------------------------------------------------------------------------------
# 4. Telegram Bot & Outage Alerting (Essential for notifications & Bot commands)
# Create a bot via @BotFather and get your Chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
TELEGRAM_TIMEOUT=10s
# Optional: Custom Telegram Bot API Server endpoint (leave commented if using official API)
# TELEGRAM_API_URL=https://api.telegram.org

# ------------------------------------------------------------------------------
# 5. Location Tracker & Live Map Tokens
# ------------------------------------------------------------------------------

# Location Tracker & Live Map
# Set to 'true' to enable Live Map and location tracking; set 'false' (default) to disable.
# ENABLE_LIVE_MAP=false
#
# Location Tracker tokens (required for device setup): generate two distinct
# values with `openssl rand -hex 16`, then paste them here. Keep them private.
# The secret token is used by both OwnTracks devices. The viewer token is part
# of the private `/live/<token>` URL. If omitted, random values are generated
# and saved in SQLite, but explicit .env values are easier to configure.
# LOCATION_SECRET_TOKEN=<paste-first-32-character-token>
# LOCATION_VIEWER_TOKEN=<paste-second-32-character-token>

# ------------------------------------------------------------------------------
# 6. AI Multi-Provider Fallback Engine (Groq -> Gemini -> OpenRouter)
# ------------------------------------------------------------------------------
# 1. Groq API Key (Primary - Blazing fast <500ms, Get free key at https://console.groq.com/keys)
# Used for: Telegram Relay proofreading, Natural Language Schedule parsing, Watchtower Incident summary
GROQ_API_KEY=your_groq_api_key_here
# Optional: Model name for Groq (default: openai/gpt-oss-120b, or qwen/qwen3.8-27b)
# GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini API Key (Fallback 1 - High daily quota, Get free key at https://aistudio.google.com/)
# Used for: Fallback 1 for AI tasks, Daily Digest summary, Morning Insight narration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Model name for Gemini (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# 3. OpenRouter API Key (Fallback 2 - Safety net, Get free key at https://openrouter.ai/keys)
# Used for: Fallback 2 for AI tasks (Strictly enforces 'openrouter/free' tier with zero cost)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 8. Pocket Sentinel Public Hub (Firestore CloudSync)
# ------------------------------------------------------------------------------
# Path to Firebase Service Account JSON key (for v11 background sync to Firestore)
# FIRESTORE_CREDENTIALS=credentials/serviceAccountKey.json
# FIRESTORE_PROJECT_ID=pocket-sentinel-hub
# Sync interval (default: 60s)
# CLOUDSYNC_INTERVAL=60s
# Discord Incoming Webhook (required to receive Location Tracker alerts)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Antigravity Agent Runner (Optional: Termux CLI paths for running agent tasks via Bot)
# AGY_BIN_PATH=/data/data/com.termux/files/home/.local/bin/agy
# AGY_WORK_DIR=/data/data/com.termux/files/home/go-app
